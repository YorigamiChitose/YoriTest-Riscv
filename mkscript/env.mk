# ===============================================================
#  环境宏：终端颜色与日志辅助
# ===============================================================

# 终端颜色
C_RED  := \e[31m
C_GRN  := \e[32m
C_YEL  := \e[33m
C_BLU  := \e[34m
C_OFF  := \e[0m

# 高亮显示构建阶段（参数为阶段说明，注意不能包含逗号）
define log_start
	@printf '$(C_RED)--- %s ---$(C_OFF)\n' '$(1)'
endef

# 高亮显示完成信息
define log_done
	@printf '$(C_GRN)--- %s ---$(C_OFF)\n' '$(1)'
endef
